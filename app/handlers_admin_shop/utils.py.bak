from app.db.database import Database


async def get_admin_shop_ids(db: Database, user_id: int) -> list[int]:
    """
    ¬озвращает только те shop_id, которые €вл€ютс€ магазинами (shop).
    """
    async with db.conn() as conn:
        cur = await conn.execute(
            """
            SELECT sa.shop_id
            FROM shop_admins sa
            JOIN shops s ON s.id = sa.shop_id
            WHERE sa.user_id=? AND s.business_type='shop'
            """,
            (user_id,),
        )
        rows = await cur.fetchall()
        return [int(r["shop_id"]) for r in rows]


async def is_shop_admin(db: Database, user_id: int) -> bool:
    ids = await get_admin_shop_ids(db, user_id)
    return len(ids) > 0
